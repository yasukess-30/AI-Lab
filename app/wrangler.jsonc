{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Cloudflare Workers configuration for the standalone AI LAB deployment.
  // Workers Builds runs the build command separately; this file defines the
  // Worker entry point and static asset routing used by Wrangler.
  "name": "ai-lab",

  // TanStack Start SSR Worker bundle generated by `vite build`.
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Serve generated static files from the client bundle; route other requests
  // to the SSR Worker.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // Non-secret runtime variables. Keep secrets out of this file.
  "vars": { "HF_ENV": "dev", "APP_SLUG": "ai-lab" }

  // Optional infrastructure is intentionally disabled. app.manifest.json
  // currently declares db=false, r2=false, kv=false and durableObject=null.
}
